{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "Taskflow - a small task-tracking API (Node.js / Express / PostgreSQL) used as the case study for the Jenkins CI/CD pipeline labs.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "jest-junit",
        { "outputDirectory": "reports", "outputName": "junit.xml" }
      ]
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "cobertura", "lcov"]
  }
}
